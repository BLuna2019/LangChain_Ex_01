""" Ejercicio 1 - Cadena LCEL: prompt | modelo | parser """

from langchain_core.output_parsers import StrOutputParser
from langchain_core.prompts import ChatPromptTemplate
from langchain_ollama import ChatOllama

# 1. Defines lo que el modelo necesita hacer con la entrada(restricciones/=, formato) y defines {texto} que sera la entrada de texto a convertir a viñetas
prompt = ChatPromptTemplate.from_messages([
    ("system", "Eres un experto en resumen. Devuelve el resumen del texto ingresado en 3 viñetas cortas, sin comentarios."),
    ("human", "{texto}"),
])

# 2. Defines el provvedor del modelo a usar. Temperatura define que tan abierto a la creatividad es el modelo. 0 = muy cerrado, 1 = muy abierto
modelo = ChatOllama(model="llama3.1", temperature=0)

# 3. Parser se queda con el texto limpio que se necesita para la salida final.
parser = StrOutputParser()

# 4. LCEL crea una cadena de ejecucion.
cadena = prompt | modelo | parser

if __name__ == "__main__":
